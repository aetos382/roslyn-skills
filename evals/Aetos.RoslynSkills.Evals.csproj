<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NoWarn>$(NoWarn);CA1303</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aetos.RoslynSkills.Evals.Tests" />
  </ItemGroup>

  <!-- A skill's evals.json is read at run time from the source tree, not from the output, so that editing one
       does not need a build. It is listed here only so the file shows up in the IDE beside the fixtures. -->
  <ItemGroup>
    <None Include="**/evals.json" />
  </ItemGroup>

</Project>
