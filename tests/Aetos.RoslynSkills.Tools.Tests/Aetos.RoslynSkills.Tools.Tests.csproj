  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Aetos.RoslynSkills.Tools/Aetos.RoslynSkills.Tools.csproj" />
  </ItemGroup>

</Project>
