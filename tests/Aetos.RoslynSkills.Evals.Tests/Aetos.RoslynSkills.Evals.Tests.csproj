<!-- The version lives in global.json's msbuild-sdks, where Dependabot can see it. -->
<Project Sdk="MSTest.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <EnableMicrosoftTestingExtensionsGitHubActionsReport>true</EnableMicrosoftTestingExtensionsGitHubActionsReport>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../evals/Aetos.RoslynSkills.Evals.csproj" />
  </ItemGroup>

</Project>
