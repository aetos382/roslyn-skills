is_global = true

csharp_style_var_for_built_in_types = true
csharp_style_var_when_type_is_apparent = true
csharp_style_var_elsewhere = true

dotnet_style_qualification_for_field = true
dotnet_style_qualification_for_property = true
dotnet_style_qualification_for_method = true
dotnet_style_qualification_for_event = true

dotnet_style_prefer_conditional_expression_over_assignment = false

csharp_style_namespace_declarations = file_scoped
dotnet_separate_import_directive_groups = true

csharp_indent_case_contents_when_block = false

csharp_preserve_single_line_statements = false

csharp_style_expression_bodied_operators = when_on_single_line
csharp_style_expression_bodied_properties = when_on_single_line
csharp_style_expression_bodied_indexers = when_on_single_line
csharp_style_expression_bodied_accessors = when_on_single_line

dotnet_analyzer_diagnostic.severity = warning

dotnet_diagnostic.CS1591.severity = suggestion

dotnet_diagnostic.CA1852.severity = suggestion

dotnet_diagnostic.IDE0001.severity = suggestion
dotnet_diagnostic.IDE0002.severity = none
dotnet_diagnostic.IDE0003.severity = none
dotnet_diagnostic.IDE0005.severity = suggestion
dotnet_diagnostic.IDE0007.severity = suggestion
dotnet_diagnostic.IDE0008.severity = none
dotnet_diagnostic.IDE0022.severity = none
dotnet_diagnostic.IDE0023.severity = suggestion
dotnet_diagnostic.IDE0024.severity = suggestion
dotnet_diagnostic.IDE0025.severity = suggestion
dotnet_diagnostic.IDE0026.severity = suggestion
dotnet_diagnostic.IDE0027.severity = suggestion
dotnet_diagnostic.IDE0028.severity = suggestion
dotnet_diagnostic.IDE0037.severity = suggestion
dotnet_diagnostic.IDE0045.severity = suggestion
dotnet_diagnostic.IDE0046.severity = suggestion
dotnet_diagnostic.IDE0047.severity = suggestion
dotnet_diagnostic.IDE0058.severity = none
dotnet_diagnostic.IDE0072.severity = suggestion
dotnet_diagnostic.IDE0160.severity = none
dotnet_diagnostic.IDE0161.severity = suggestion
dotnet_diagnostic.IDE0200.severity = suggestion
dotnet_diagnostic.IDE0270.severity = silent
dotnet_diagnostic.IDE0290.severity = suggestion
dotnet_diagnostic.IDE0305.severity = none

dotnet_naming_symbols.types_and_namespaces.applicable_kinds = class, struct, enum, delegate, namespace

dotnet_naming_symbols.interfaces.applicable_kinds = interface

dotnet_naming_symbols.type_parameters.applicable_kinds = type_parameter

dotnet_naming_symbols.non_private_members.applicable_kinds = method, property, event, field, local_function
dotnet_naming_symbols.non_private_members.applicable_accessibilities = public, internal, protected, protected_internal, private_protected, file, local

dotnet_naming_symbols.parameters_and_local_variables.applicable_kinds = parameter, local

dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = *

dotnet_naming_symbols.constants.applicable_kinds = field, local
dotnet_naming_symbols.constants.required_modifiers = const
dotnet_naming_symbols.constants.applicable_accessibilities = *

dotnet_naming_symbols.fields.applicable_kinds = field
dotnet_naming_symbols.fields.applicable_accessibilities = private

dotnet_naming_style.pascal_case.capitalization = pascal_case

dotnet_naming_style.camel_case.capitalization = camel_case

dotnet_naming_style.pascal_case_starting_with_large_i.capitalization = pascal_case
dotnet_naming_style.pascal_case_starting_with_large_i.required_prefix = I

dotnet_naming_style.pascal_case_starting_with_large_t.capitalization = pascal_case
dotnet_naming_style.pascal_case_starting_with_large_t.required_prefix = T

dotnet_naming_style.camel_case_starting_with_underscore.capitalization = camel_case
dotnet_naming_style.camel_case_starting_with_underscore.required_prefix = _

# 型と名前空間は PascalCase
dotnet_naming_rule.types_and_namespaces_should_be_pascal_case.symbols = types_and_namespaces
dotnet_naming_rule.types_and_namespaces_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.types_and_namespaces_should_be_pascal_case.severity = warning

# インターフェイスは大文字の I で始まる PascalCase
dotnet_naming_rule.interfaces_should_be_pascal_case_starting_with_large_i.symbols = interfaces
dotnet_naming_rule.interfaces_should_be_pascal_case_starting_with_large_i.style = pascal_case_starting_with_large_i
dotnet_naming_rule.interfaces_should_be_pascal_case_starting_with_large_i.severity = warning

# 型パラメーターは大文字の T で始まる PascalCase
dotnet_naming_rule.type_parameters_should_be_pascal_case_starting_with_large_t.symbols = type_parameters
dotnet_naming_rule.type_parameters_should_be_pascal_case_starting_with_large_t.style = pascal_case_starting_with_large_t
dotnet_naming_rule.type_parameters_should_be_pascal_case_starting_with_large_t.severity = warning

# プライベートでないメンバーは PascalCase
dotnet_naming_rule.non_private_members_should_be_pascal_case.symbols = non_private_members
dotnet_naming_rule.non_private_members_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.non_private_members_should_be_pascal_case.severity = warning

# パラメーターとローカル変数は camelCase
dotnet_naming_rule.parameters_and_local_variables_should_be_camel_case.symbols = parameters_and_local_variables
dotnet_naming_rule.parameters_and_local_variables_should_be_camel_case.style = camel_case
dotnet_naming_rule.parameters_and_local_variables_should_be_camel_case.severity = warning

# フィールドはアンダースコアで始まる camelCase
dotnet_naming_rule.fields_should_be_camel_case_starting_with_underscore.symbols = fields
dotnet_naming_rule.fields_should_be_camel_case_starting_with_underscore.style = camel_case_starting_with_underscore
dotnet_naming_rule.fields_should_be_camel_case_starting_with_underscore.severity = warning

# static readonly フィールドは PascalCase
dotnet_naming_rule.static_readonly_fields_should_be_pascal_case.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.static_readonly_fields_should_be_pascal_case.severity = warning

# 定数は PascalCase
dotnet_naming_rule.constants_should_be_pascal_case.symbols = constants
dotnet_naming_rule.constants_should_be_pascal_case.style = pascal_case
dotnet_naming_rule.constants_should_be_pascal_case.severity = warning
